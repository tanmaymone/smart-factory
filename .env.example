# Copy to .env and adjust as needed for local development.
# docker compose reads .env automatically for ${VAR} substitution.

POSTGRES_USER=smartfactory
POSTGRES_PASSWORD=smartfactory
POSTGRES_DB=smart_factory
POSTGRES_PORT=5432

# M4.1: TLS broker (8883). Plaintext 1883 is disabled in infra/mosquitto/mosquitto.conf.
MQTT_TLS_PORT=8883
MQTT_BIND_ADDRESS=127.0.0.1

# Mosquitto users (Generate-DevTls.ps1 / generate-dev-tls.sh uses dev defaults below).
# MQTT_CENTRAL_USERNAME=central-backend
# MQTT_CENTRAL_PASSWORD=central-dev
# MQTT_HEALTH_USERNAME=healthcheck
# MQTT_HEALTH_PASSWORD=healthcheck-dev
# MQTT_EDGE_USERNAME=edge-INDORE
# MQTT_EDGE_PASSWORD=edge-indore-dev

# Standalone plant edge (docker-compose.edge.yml) — required when not using dev stack.
# MQTT_USERNAME=edge-INDORE
# MQTT_PASSWORD=edge-indore-dev
# MQTT_BROKER_URL=ssl://<cloud-host>:8883
# MQTT_CA_CERT_PATH=/certs/ca.crt
# CENTRAL_BASE_URL=https://<cloud-host>
# CENTRAL_CA_CERT_PATH=/certs/ca.crt
# EDGE_CERTS_DIR=./infra/certs

# Caddy (cloud / dev compose)
# CADDY_SITE_ADDRESS=your.domain.example
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# Optional hostname verification override for Paho ssl:// clients
# MQTT_TLS_VERIFY_HOSTNAME=true

# First-run bootstrap admin for registry and actor provisioning (M3.2). Empty fails closed.
# Bake the same value into Next as NEXT_PUBLIC_BOOTSTRAP_TOKEN (visible in the browser until M4.2).
# APP_BOOTSTRAP_TOKEN=dev-bootstrap-token
# NEXT_PUBLIC_BOOTSTRAP_TOKEN=dev-bootstrap-token

# Optional: Prosys OPC UA endpoint for registry seed (defaults to localhost on the host)
# OPC_ENDPOINT_URL=opc.tcp://Tanmay:53530/OPCUA/SimulationServer

# Container edge only (docker-compose.edge.yml). Host mvnw runs ignore these.
# OPC_UA_ENDPOINT=opc.tcp://host.docker.internal:53530/OPCUA/SimulationServer
# EDGE_MQTT_CLIENT_ID=plant-edge-indore